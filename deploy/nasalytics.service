# /etc/systemd/system/nasalytics.service
# Arka uç (FastAPI + derlenmiş arayüz) yalnızca 127.0.0.1:8790'da dinler; dışarıya Apache/nginx açar.
[Unit]
Description=Nasalytics - Astronot Saglik Monitoru (NASA Space Apps 2026)
After=network-online.target
Wants=network-online.target

[Service]
User=nasalytics
Group=nasalytics
WorkingDirectory=/opt/nasalytics
Environment=PYTHONUNBUFFERED=1
Environment=URL_PREFIX=/nasalytics
ExecStart=/opt/nasalytics/.venv/bin/uvicorn backend.server:app --host 127.0.0.1 --port 8790 --proxy-headers --forwarded-allow-ips 127.0.0.1 --ws-max-size 131072 --no-server-header
# Sertleştirme: hizmet yetki yükseltemez, sistem dizinlerine yazamaz, diğer kullanıcıların ev dizinlerini göremez
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
