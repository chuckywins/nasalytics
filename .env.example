# Copy to .env and fill in. Never commit .env.

# Required for AI assessment, intervention ranking and the VEGA assistant
ANTHROPIC_API_KEY=

# VEGA's voice and spoken alarms (one key, or several separated by commas)
GEMINI_API_KEYS=

# Live NASA DONKI space weather (https://api.nasa.gov). Falls back to DEMO_KEY if empty.
NASA_API_KEY=

# Optional backup voice
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Your public host name(s), comma-separated, if you deploy this somewhere other than localhost
# ALLOWED_HOSTS=example.com,www.example.com

# Optional limits
# RATE_PER_MIN=120
# DAILY_BUDGET_USD=40
